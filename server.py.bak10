BASE=Path(__file__).resolve().parent
STUDIO=Path(os.environ.get('SHELFMADE_STUDIO',str(Path.home()/'Documents'/'ContentEmpire-Studio'))).resolve()
DB=BASE/'decisions.sqlite3'
REMOTE_CONFIG=BASE/'remote.json'
def remote_origin():
 try:
  origin=json.loads(REMOTE_CONFIG.read_text()).get('origin','')
  parsed=urllib.parse.urlparse(origin)
  if parsed.scheme=='https' and parsed.hostname and parsed.hostname.endswith('.ts.net') and parsed.path in ('','/') and not parsed.username and not parsed.port:return origin.rstrip('/')
 except (OSError,ValueError,TypeError):pass
 return ''
def connection():
 c=sqlite3.connect(DB); c.execute('CREATE TABLE IF NOT EXISTS editorial_reviews(id TEXT PRIMARY KEY, fingerprint TEXT NOT NULL, checks TEXT NOT NULL, updated TEXT DEFAULT CURRENT_TIMESTAMP)'); c.execute('CREATE TABLE IF NOT EXISTS decisions(id TEXT PRIMARY KEY, status TEXT NOT NULL, updated TEXT DEFAULT CURRENT_TIMESTAMP)'); return c
def inventory():
 with connection() as c: statuses=dict(c.execute('SELECT id,status FROM decisions'))
 items=[]
 for p in sorted((STUDIO/'01_REVIEW').glob('SHELFMADE__*')):
  if not p.is_dir() or p.is_symlink(): continue
  id=hashlib.sha256(p.name.encode()).hexdigest()[:24]
  video=p/'final.mp4'; caption=p/'POST_THIS.txt'
  ready=video.is_file() and not video.is_symlink() and video.stat().st_size>0 and caption.is_file() and not caption.is_symlink()
  items.append(dict(id=id,title=p.name.removeprefix('SHELFMADE__shelfmade-').replace('-',' ').title(),status=statuses.get(id,'review'),ready=ready,bytes=video.stat().st_size if video.is_file() else 0,caption=caption.read_text(errors='replace') if ready else 'Incomplete package',folder=p.name))
 for job in jobs.list_jobs():
  if job['state']!='ready': continue
  p=jobs.package(job); book=next(b for b in jobs.BOOKS if b['id']==job['book']); id='job-'+job['id']
  ready=(p/'final.mp4').is_file() and (p/'POST_THIS.txt').is_file()
  items.append(dict(id=id,title=book['title']+' · New local draft',status=statuses.get(id,'review'),ready=ready,bytes=(p/'final.mp4').stat().st_size if ready else 0,caption=((p/'warning.txt').read_text()+'\n\n' if (p/'warning.txt').exists() else '')+(p/'POST_THIS.txt').read_text() if ready else 'Incomplete',folder=str(p),generated=True,book_id=book['id'],edition=job.get('edition',1)))
 for draft in replacement_drafts.list_drafts():
  p=Path(draft['folder']);book=next((b for b in jobs.BOOKS if b['id']==draft['book']),None)
  if not book or not p.resolve().is_relative_to(BASE/'replacements'):continue
  ready=(p/'final.mp4').is_file() and (p/'POST_THIS.txt').is_file()
  items.append(dict(id=draft['id'],title=book['title']+' · Improved replacement',status=statuses.get(draft['id'],'review'),ready=ready,bytes=(p/'final.mp4').stat().st_size if ready else 0,caption=(p/'POST_THIS.txt').read_text() if ready else 'Incomplete',folder=str(p),generated=True,replacement=True,book_id=book['id']))
 for p in sorted([*(STUDIO/'LONGFORM').glob('*'),*(BASE/'full-generated').glob('*')]):
  if not p.is_dir() or p.is_symlink():continue
  videos=[v for v in p.glob('*_LONGFORM.mp4') if not v.is_symlink()]
  if len(videos)!=1:continue
  video=videos[0];caption=p/'POST_THIS.txt';id='long-'+hashlib.sha256(p.name.encode()).hexdigest()[:24]
  ready=video.stat().st_size>0 and caption.is_file() and not caption.is_symlink()
  items.append(dict(id=id,title=video.stem.removesuffix('_LONGFORM').replace('_',' '),status=statuses.get(id,'review'),ready=ready,bytes=video.stat().st_size,caption=caption.read_text(errors='replace') if ready else 'Incomplete package',folder=str(p),generated=True,content_type='full',video_name=video.name))
 for item in items:
  if item.get('content_type')=='full':
   folder=Path(item['folder'])
   try:
    metadata=json.loads((folder/'package.json').read_text());item['title']=metadata['title'];item['publish_title']=metadata.get('publish_title',metadata['title'])
   except (OSError,ValueError,KeyError):pass
   try:
    plan=json.loads((folder/'storyboard.json').read_text());item['visual_plan']={'version':plan['version'],'scenes':len(plan['scenes']),'unmatched':sum(s['kind']=='concept' for s in plan['scenes']),'needs_visual_review':sum(bool(s.get('review_required')) for s in plan['scenes']),'duration':plan['duration']}
   except (OSError,ValueError,KeyError):pass
  p=Path(item['folder']) if item.get('generated') else STUDIO/'01_REVIEW'/item['folder']
  if item.get('content_type')=='full':
   try:
    script=json.loads((p/'script.json').read_text());book_id=str(script.get('book_id',''))
    if any(str(b['id'])==book_id for b in jobs.BOOKS):item['book_id']=book_id
   except (OSError,ValueError,TypeError):pass
  item['quality']=quality.inspect(p,item.get('video_name','final.mp4'),item.get('content_type')=='full')
  item.setdefault('content_type','short')
  if item['content_type']=='short' and item['quality'].get('creative',{}):item['publish_title']=item['quality']['creative'].get('public_title',item['title'])
  item['publish_caption']=captions.clean(item['caption'])
  if item['content_type']=='full':
   raw=item['caption'];parts=raw.split('--- DESCRIPTION ---',1)
   item['publish_caption']=captions.clean(parts[-1].split('--- TO POST ---',1)[0]) if len(parts)==2 else captions.clean(raw)
  if (p/'footage-selection.json').is_file():
   try:
    footage=json.loads((p/'footage-selection.json').read_text());item['footage']={'version':footage['version'],'fresh_clips':len(footage['assets']),'previously_used_excluded':footage['previously_used_excluded']}
    item['footage']['credits']=[{'creator':str(a.get('creator','Pexels contributor'))[:160],'url':a.get('source_url','')} for a in footage['assets'] if str(a.get('source_url','')).startswith(('https://www.pexels.com/video/','https://www.pexels.com/photo/'))]
   except (OSError,ValueError,KeyError):pass
  item['allowed_platforms']=['youtube'] if item['content_type']=='full' else ['youtube','instagram','tiktok']
 return items
def daily_inventory():
 items=inventory();availability=multiplatform.availability(items)
 for item in items:item['published_everywhere']=all(availability[item['id']].values())
 return items
class Handler(BaseHTTPRequestHandler):
 def send(self,data,kind='application/json',status=200,extra=None):
  if isinstance(data,(dict,list)): data=json.dumps(data).encode()
  if isinstance(data,str): data=data.encode()
  self.send_response(status); self.send_header('Content-Type',kind); self.send_header('Content-Length',str(len(data))); self.send_header('X-Content-Type-Options','nosniff')
  self.send_header('Cache-Control','no-store')
  self.send_header('Referrer-Policy','no-referrer')
  if extra:
   for k,v in extra.items(): self.send_header(k,v)
  self.end_headers(); self.wfile.write(data)
 def local_host(self):
  host=self.headers.get("Host", "")
  allowed=("127.0.0.1", "localhost")
  return host.split(":")[0] in allowed or bool(remote_origin() and host==urllib.parse.urlparse(remote_origin()).netloc)
 def do_GET(self):
  if not self.local_host():return self.send({"error":"Local access only"},status=403)
  path=urllib.parse.urlparse(self.path).path
  if path=='/api/auth/status':return self.send({'configured':access.configured(),'build':BUILD,'source_revision':SOURCE_REVISION})
  authenticated=access.valid(self.headers.get('Cookie'))
  if path in ('/','/shelfmade','/studio','/studio/mindlore','/studio/minddoodles','/studio/minddoodles/create','/studio/animationdoodles','/studio/animationdoodles/create') and not authenticated:return self.send((BASE/'login.html').read_bytes(),'text/html; charset=utf-8')
  if path=='/':
   try:
    import brand_workspace
    return self.send(brand_workspace.entrance(),'text/html; charset=utf-8')
   except (OSError,ValueError):return self.send((BASE/'index.html').read_bytes().replace(b'__SHELFMADE_BUILD__',BUILD.encode()),'text/html; charset=utf-8')
  if not authenticated:return self.send({'error':'Sign in to continue'},status=401)
  if path in ('/studio/minddoodles','/studio/animationdoodles'):return self.send((minddoodles_bridge.UI/'minddoodles.html').read_bytes(),'text/html; charset=utf-8')
  if path in ('/studio/minddoodles/create','/studio/animationdoodles/create'):return self.send((minddoodles_bridge.UI/'minddoodles-create.html').read_bytes(),'text/html; charset=utf-8')
  if path=='/api/minddoodles/shorts':return self.send(minddoodles_bridge.short_creator().snapshot())
  if path=='/api/minddoodles/action-package':
   recipe=(urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get('recipe') or [''])[0]
   try:
    package=minddoodles_bridge.action_package(recipe)
    return self.send(package,extra={'Content-Disposition':f'attachment; filename="{recipe}.action-package.json"'})
   except (OSError,ValueError,KeyError):return self.send({'error':'No action package exists for that story'},status=404)
  if path=='/api/minddoodles/short-media':
   try:return minddoodles_bridge.short_stream(self,(urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get('id') or [''])[0])
   except (OSError,ValueError,KeyError):return self.send({'error':'Video unavailable'},status=404)
  if path=='/api/minddoodles/action-test-media':
   try:return minddoodles_bridge.action_test_stream(self,(urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get('id') or [''])[0])
   except (OSError,ValueError,KeyError):return self.send({'error':'Action-test video unavailable'},status=404)
  if path=='/api/minddoodles/local-action-preview-media':
   try:return minddoodles_bridge.local_action_preview_stream(self,(urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get('id') or [''])[0])
   except (OSError,ValueError,KeyError):return self.send({'error':'Local preview video unavailable'},status=404)
  if path=='/api/minddoodles/lipsync-pilot-media':
   try:return minddoodles_bridge.lipsync_pilot_stream(self)
   except (OSError,ValueError,KeyError):return self.send({'error':'Local lip-sync sample unavailable'},status=404)
  if path=='/api/minddoodles/coffee-break-review-media':
   try:return minddoodles_bridge.coffee_break_review_stream(self)
   except (OSError,ValueError,KeyError):return self.send({'error':'Coffee Break review video unavailable'},status=404)
  if path=='/api/minddoodles/production':return self.send(minddoodles_bridge.production_snapshot())
  if path=='/api/minddoodles/quality':return self.send(minddoodles_bridge.quality_snapshot())
  if path=='/api/minddoodles/account-setup':
   try:return self.send(minddoodles_bridge.account_setup_snapshot())
   except ValueError as error:return self.send({'error':str(error)},status=503)
  if path=='/api/minddoodles/voice-audition':
   character=(urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get('character') or [''])[0]
   name={'leo':'Leo-voice-audition.wav','mia':'Mia-voice-audition.wav'}.get(character)
   if name:
    sample=minddoodles_bridge.UI.parent/'minddoodles-upgrade/script-review-stage3'/name
    if sample.is_file() and not sample.is_symlink() and sample.stat().st_size<1000000:return self.send(sample.read_bytes(),'audio/wav')
   return self.send({'error':'Voice audition unavailable'},status=404)
  if path=='/api/minddoodles/approved-poster':
   poster=minddoodles_bridge.UI.parent/'minddoodles-upgrade/leo-mia-10second-review/Opening-frame.png'
   if poster.is_file() and not poster.is_symlink() and poster.stat().st_size<10000000:return self.send(poster.read_bytes(),'image/png')
   return self.send({'error':'Reference poster unavailable'},status=404)
  if path=='/api/minddoodles/approved-sample':
   sample=minddoodles_bridge.UI.parent/'minddoodles-upgrade/free-video-review/Leo-Mia-10-second-review.mp4'
   if sample.is_file() and not sample.is_symlink() and sample.stat().st_size<30000000:return self.send(sample.read_bytes(),'video/mp4')
   return self.send({'error':'Review sample unavailable'},status=404)
  if path=='/api/minddoodles/design-reference':
   reference=minddoodles_bridge.UI.parent/'minddoodles-upgrade/polished-scene-v1/Focus-mode-storyboard.png'
   if reference.is_file() and not reference.is_symlink() and reference.stat().st_size<10000000:return self.send(reference.read_bytes(),'image/png')
   return self.send({'error':'Design reference unavailable'},status=404)
  if path=='/api/minddoodles/sample':
   sample=minddoodles_bridge.UI.parent/'minddoodles-upgrade/animation-sample/final.mp4'
   if sample.is_file() and not sample.is_symlink() and sample.stat().st_size<30000000:return self.send(sample.read_bytes(),'video/mp4')
   return self.send({'error':'Style sample unavailable'},status=404)
  if path=='/api/minddoodles':return self.send(minddoodles_bridge.snapshot())
  if path=='/api/minddoodles/media':
   try:
    query=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
    return minddoodles_bridge.stream(self,query.get('day',[''])[0],query.get('item',[''])[0])
   except (ValueError,OSError,IndexError):return self.send({'error':'MindDoodles video unavailable'},status=404)
  if path=='/shelfmade':return self.send((BASE/'index.html').read_bytes().replace(b'__SHELFMADE_BUILD__',BUILD.encode()),'text/html; charset=utf-8')
  if path in ('/studio','/studio/mindlore','/api/studio/workspace','/api/studio/video','/api/studio/cover'):
   try:
    import brand_workspace
    query=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query,keep_blank_values=True)
    if path=='/studio':return self.send(brand_workspace.entrance(),'text/html; charset=utf-8')
    if path=='/studio/mindlore':return self.send(brand_workspace.page(),'text/html; charset=utf-8')
    if path=='/api/studio/workspace':return self.send(brand_workspace.snapshot(query))
    if path=='/api/studio/cover':return brand_workspace.cover(self,query)
    return brand_workspace.stream(self,query)
   except ValueError as error:return self.send({'error':str(error)},status=400)
   except Exception:return self.send({'error':'Brand workspace unavailable. Check the local migration guide.'},status=503)
  if path=='/api/mindlore/publishing.js':
   try:
    import brand_workspace
    return self.send((brand_workspace.BASE/'mindlore-publishing.js').read_bytes(),'text/javascript; charset=utf-8')
   except OSError:return self.send({'error':'MindLore publishing UI unavailable.'},status=503)
  if path=='/batch-approval.js':
   try:return self.send((BASE/'batch-approval.js').read_bytes(),'text/javascript; charset=utf-8')
   except OSError:return self.send({'error':'Batch approval UI unavailable.'},status=503)
  if path in ('/api/mindlore/workflow','/api/mindlore/item'):
   try:
    import brand_workspace
    query=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query,keep_blank_values=True)
    return self.send(brand_workspace.mindlore_get(path,query))
   except ValueError as error:return self.send({'error':str(error)},status=400)
   except Exception:return self.send({'error':'MindLore workflow unavailable. Check the local maintenance guide.'},status=503)
  if path=='/api/mindlore/buffer/connection':
   try:
    import brand_workspace
    return self.send(brand_workspace.mindlore_connection_status())
   except Exception:return self.send({'error':'MindLore connection status is unavailable.'},status=503)
  if path=='/api/items': return self.send(inventory())
  if path=='/api/health': return self.send({**jobs.health(),'access':'owner sign-in','remote':bool(remote_origin())})
  if path=='/api/publishing/connection':return self.send({**publishing.connection_status(), 'direct_youtube':youtube_api.status()})
  if path=='/api/publishing':return self.send(publishing.list_posts())
  if path=='/api/social':return self.send(multiplatform.social_status())
  if path=='/api/multiplatform':return self.send({**multiplatform.status(),'existing':multiplatform.availability(inventory())})
  if path=='/api/books': return self.send(jobs.refresh_catalogue())
  if path=='/api/editorial-memory':
   try:
    available=inventory();focus_id=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get('item',[None])[0]
    focus=next((i for i in available if i['id']==focus_id),None) if focus_id else None
    if focus_id and not focus:return self.send({'error':'Video unavailable'},status=404)
    return self.send(editorial_memory.snapshot(available,focus=focus))
   except Exception:return self.send({'available':False,'message':'Editorial memory could not be read. Run the local maintenance check.'},status=503)
  if path=='/api/book-series':
   try:return self.send(book_series.snapshot(inventory(),publishing.list_posts()+multiplatform.rows(),jobs.BOOKS))
   except Exception:return self.send({'available':False,'message':'Book series could not be read. Run the local maintenance check.'},status=503)
  if path=='/api/reliability':return self.send(reliability.dashboard())
  if path=='/api/product-sales':return self.send(product_sales.snapshot())
  if path=='/api/operations':
   try:return self.send(operations.snapshot())
   except Exception:return self.send({'available':False,'message':'Storage information is unavailable. Run the local maintenance check.'},status=503)
  if path=='/api/evidence-journal':
   try:return self.send(evidence_journal.snapshot())
   except Exception:return self.send({'available':False,'message':'Evidence journal could not be read. Run the local maintenance check.'},status=503)
  if path=='/api/audience':
   try:return self.send(audience_learning.snapshot())
   except Exception:return self.send({'available':False,'message':'Audience history is unavailable. Run the local maintenance check.'},status=503)
  if path=='/api/history':return self.send(daily_plan.history())
  if path=='/api/daily':return self.send(daily_plan.prepare(daily_inventory(),publishing.list_posts()+multiplatform.rows()))
  if path=='/api/full-daily':return self.send(daily_plan.full_pick(inventory(),publishing.list_posts()))
  if path=='/api/footage/status':
   import footage_director
   return self.send(footage_director.status())
  if path=='/api/full-books':return self.send(cinematic_content.available_books())
  if path=='/api/full-jobs':return self.send(full_jobs.list_jobs())
  if path=='/api/generation-status':
   import generation_status
   try:return self.send(generation_status.snapshot())
   except Exception:return self.send({'available':False,'message':'Daily production status is unavailable. Run Check-ShelfMade.command.'},status=503)
  if path=='/api/jobs': return self.send(jobs.list_jobs())
  parts=path.strip('/').split('/')
  if len(parts)==3 and parts[0]=='media':
   item=next((x for x in inventory() if x['id']==parts[1]),None)
   if not item or not item['ready']: return self.send({'error':'Package unavailable'},status=404)
   p=Path(item['folder']) if item.get('generated') else STUDIO/'01_REVIEW'/item['folder']
   video=p/item.get('video_name','final.mp4')
   if parts[2]=='thumbnail':
    thumbnail=p/('THUMBNAIL.jpg' if (p/'THUMBNAIL.jpg').is_file() else 'THUMBNAIL.png')
    if not thumbnail.is_file():return self.send('',status=404)
    return self.send(thumbnail.read_bytes(),'image/jpeg' if thumbnail.suffix=='.jpg' else 'image/png',extra={'Content-Disposition':'attachment; filename="ShelfMade-thumbnail'+thumbnail.suffix+'"'})
   if parts[2]=='poster':
    if item.get('content_type')=='full' and (p/'THUMBNAIL.jpg').is_file():return self.send((p/'THUMBNAIL.jpg').read_bytes(),'image/jpeg')
    if item.get('content_type')=='full' and (p/'THUMBNAIL.png').is_file():return self.send((p/'THUMBNAIL.png').read_bytes(),'image/png')
    if (p/'cover.jpg').is_file():return self.send((p/'cover.jpg').read_bytes(),'image/jpeg')
    poster=quality.CACHE/(item['quality']['fingerprint']+'.jpg')
    if not poster.exists():
     try:subprocess.run(['ffmpeg','-v','error','-y','-ss','2','-i',str(video),'-frames:v','1','-vf','scale=270:480',str(poster)],capture_output=True,timeout=20,check=True)
     except Exception:return self.send('',status=404)
    return self.send(poster.read_bytes(),'image/jpeg')
   if parts[2]=='package':
    b=io.BytesIO()
    with zipfile.ZipFile(b,'w',zipfile.ZIP_STORED) as z:
     z.write(video,video.name); z.write(p/'POST_THIS.txt','POST_THIS.txt')
     if item.get('content_type')=='full' and (p/'THUMBNAIL.png').is_file():z.write(p/'THUMBNAIL.png','THUMBNAIL.png')
     if (p/'THUMBNAIL.jpg').is_file():z.write(p/'THUMBNAIL.jpg','THUMBNAIL.jpg')
     for name in ['Footage-credits.txt','visual-briefs.json','footage-selection.json','storyboard.json','creative-review.json','content-review.json','script.json']:
      if (p/name).is_file():z.write(p/name,name)
    return self.send(b.getvalue(),'application/zip',extra={'Content-Disposition':f'attachment; filename="shelfmade-{item["id"]}.zip"'})
   if parts[2]=='video':
    f=video; size=f.stat().st_size; start=0; end=size-1; status=200
    value=self.headers.get('Range')
    if value:
     try:
      a,b=value.removeprefix('bytes=').split('-'); start=int(a) if a else max(0,size-int(b)); end=min(int(b),size-1) if a and b else size-1
      if start<0 or start>end or start>=size: raise ValueError()
      status=206
     except ValueError: return self.send('',status=416,extra={'Content-Range':f'bytes */{size}'})
    self.send_response(status); self.send_header('Content-Type','video/mp4'); self.send_header('Accept-Ranges','bytes'); self.send_header('Content-Length',str(end-start+1))
    if status==206: self.send_header('Content-Range',f'bytes {start}-{end}/{size}')
    self.end_headers()
    with f.open('rb') as source:
     source.seek(start); remaining=end-start+1
     try:
      while remaining:
       chunk=source.read(min(65536,remaining)); self.wfile.write(chunk); remaining-=len(chunk)
     except (BrokenPipeError,ConnectionResetError): pass
    return
  self.send({'error':'Not found'},status=404)
 def do_POST(self):
  if not self.local_host():return self.send({"error":"Local access only"},status=403)
  if self.headers.get('Origin') not in (None,f'http://{self.headers.get("Host")}',remote_origin()): return self.send({'error':'Origin rejected'},status=403)
  if self.headers.get('X-ShelfMade')!='local': return self.send({'error':'Invalid request'},status=403)
  if self.path in ('/auth/setup','/auth/login','/auth/logout'):
   try:
    if self.path=='/auth/logout':
     access.logout(self.headers.get('Cookie'));return self.send({'status':'signed_out'},extra={'Set-Cookie':access.cookie(secure=self.headers.get('Host','').split(':')[0] not in ('127.0.0.1','localhost'))})
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict):raise ValueError('Invalid request')
    if self.path=='/auth/setup' and self.headers.get('Host','').split(':')[0] not in ('127.0.0.1','localhost'):raise ValueError('Create owner access on the laptop first.')
    token=access.setup(body.get('password')) if self.path=='/auth/setup' else access.login(body.get('password'),self.client_address[0])
    return self.send({'status':'signed_in'},extra={'Set-Cookie':access.cookie(token,secure=self.headers.get('Host','').split(':')[0] not in ('127.0.0.1','localhost'))})
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if not access.valid(self.headers.get('Cookie')):return self.send({'error':'Sign in to continue'},status=401)
  if self.path=='/api/minddoodles/action':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<20000:raise ValueError('Invalid request size')
    return self.send(minddoodles_bridge.action(json.loads(self.rfile.read(length))))
   except ValueError as error:return self.send({'error':str(error)[:220]},status=400)
   except OSError:return self.send({'error':'MindDoodles could not save or start this request. Check its saved build status before retrying.'},status=503)
  if self.path=='/api/mindlore/buffer/connect':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid connection request size.')
    body=json.loads(self.rfile.read(length))
    import brand_workspace
    return self.send(brand_workspace.connect_mindlore_buffer(body))
   except (ValueError,TypeError) as error:return self.send({'error':str(error)},status=400)
   except Exception:return self.send({'error':'MindLore connection check failed. Existing credentials were preserved.'},status=503)
  if self.path in ('/api/mindlore/prepare','/api/mindlore/approve','/api/mindlore/publish','/api/mindlore/retry','/api/mindlore/refresh','/api/mindlore/youtube/connect'):
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=20000:raise ValueError('Invalid MindLore request size.')
    body=json.loads(self.rfile.read(length))
    import brand_workspace
    return self.send(brand_workspace.mindlore_post(self.path,body))
   except (ValueError,TypeError) as error:return self.send({'error':str(error)},status=400)
   except Exception:return self.send({'error':'MindLore action could not complete. Existing receipts were preserved.'},status=503)
  if urllib.parse.urlparse(self.path).path.startswith('/api/studio/'):
   return self.send({'error':'Brand workspaces are read-only.'},status=405)
  if self.path=='/api/evidence-journal':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=8192:raise ValueError('Invalid journal request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict):raise ValueError('Invalid journal request')
    evidence=audience_learning.snapshot()
    ident=evidence_journal.save(evidence,body.get('platform'),body.get('format'),body.get('note'))
    return self.send({'saved':True,'id':ident})
   except (ValueError,TypeError) as error:return self.send({'error':str(error)},status=400)
   except Exception:return self.send({'error':'Evidence could not be saved. Run the local maintenance check.'},status=503)
  if self.path=='/api/editorial-feedback':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=8192:raise ValueError('Invalid feedback request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict):raise ValueError('Invalid feedback request')
    item=next((i for i in inventory() if i['id']==body.get('item')),None)
    note=editorial_memory.save(item,body.get('fingerprint'),body.get('category'),body.get('verdict'),body.get('note'))
    return self.send({'saved':True,'id':note['id']})
   except (ValueError,TypeError) as error:return self.send({'error':str(error)},status=400)
   except sqlite3.Error:return self.send({'error':'Feedback could not be saved. Run the local maintenance check.'},status=503)
  if self.path=='/api/buffer/connect':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    return self.send(buffer_api.connect(body.get('token')))
   except (ValueError,TypeError) as error:return self.send({'error':str(error)},status=400)
  if self.path in ('/api/publishing/sync','/api/publishing/status-sync'):
   warnings=[]
   tasks=[multiplatform.sync,multiplatform.refresh_connections_if_due]
   if self.path=='/api/publishing/sync':tasks.extend([youtube_api.sync_publications,lambda:multiplatform.remote_history(force=True)])
   for task in tasks:
    try:
     result=task()
     if isinstance(result,dict) and result.get('error'):warnings.append(result['error'])
    except Exception as error:warnings.append(str(error))
   if self.path=='/api/publishing/sync':
    try:audience_learning.bind_items(inventory(),publishing.list_posts()+multiplatform.rows())
    except Exception:warnings.append('Audience history could not attach local draft details. Publication status remains available.')
   return self.send({'ok':not warnings,'warnings':warnings,'status':multiplatform.status()})
  if self.path=='/api/multiplatform/publish':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    if body.get('confirm') is not True:raise ValueError('Confirm publishing destinations first.')
    with publishing.connect() as c:post=c.execute('SELECT * FROM publications WHERE id=?',(body.get('id'),)).fetchone()
    if not post:raise ValueError('Save a title and caption first.')
    item=next((i for i in inventory() if i['id']==post['item']),None)
    if not item:raise ValueError('Video unavailable.')
    if item.get('content_type')=='full':raise ValueError('Use the YouTube full-video upload queue for this video.')
    with connection() as c:
     decision=c.execute('SELECT status FROM decisions WHERE id=?',(item['id'],)).fetchone()
     review=c.execute('SELECT fingerprint FROM editorial_reviews WHERE id=?',(item['id'],)).fetchone()
    approved=decision and decision[0]=='approved' and review and review[0]==item['quality']['fingerprint']
    folder=Path(item['folder']) if item.get('generated') else STUDIO/'01_REVIEW'/item['folder']
    return self.send(multiplatform.start(item,dict(post),folder/'final.mp4',body.get('platforms'),bool(approved)))
   except (ValueError,TypeError) as error:return self.send({'error':str(error)},status=400)
  if self.path=='/api/publishing/upload':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict):raise ValueError('Invalid request')
    with publishing.connect() as c:post=c.execute('SELECT * FROM publications WHERE id=?',(body.get('id'),)).fetchone()
    if not post:raise ValueError('Preparation not found')
    item=next((i for i in inventory() if i['id']==post['item']),None)
    if not item or item['quality']['fingerprint']!=post['fingerprint']:raise ValueError('Video changed. Review and prepare the current version.')
    with connection() as c:
     decision=c.execute('SELECT status FROM decisions WHERE id=?',(item['id'],)).fetchone()
     review=c.execute('SELECT fingerprint FROM editorial_reviews WHERE id=?',(item['id'],)).fetchone()
    if not decision or decision[0]!='approved' or not review or review[0]!=post['fingerprint'] or not item['quality']['can_approve']:raise ValueError('Current video requires complete editorial approval')
    folder=Path(item['folder']) if item.get('generated') else STUDIO/'01_REVIEW'/item['folder']
    thumbnail=(folder/('THUMBNAIL.jpg' if (folder/'THUMBNAIL.jpg').is_file() else 'THUMBNAIL.png')) if item.get('content_type')=='full' else None
    return self.send(youtube_api.send_upload(post['id'],folder/item.get('video_name','final.mp4'),body.get('visibility'),body.get('madeForKids'),thumbnail=thumbnail))
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if self.path=='/api/publishing/prepare':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=24000:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict):raise ValueError('Invalid request')
    item=next((i for i in inventory() if i['id']==body.get('id')),None)
    if not item:raise ValueError('Video not found')
    with connection() as c:
     decision=c.execute('SELECT status FROM decisions WHERE id=?',(item['id'],)).fetchone()
     review=c.execute('SELECT fingerprint FROM editorial_reviews WHERE id=?',(item['id'],)).fetchone()
    approved=decision and decision[0]=='approved' and review and review[0]==item['quality']['fingerprint']
    return self.send(publishing.prepare(item,body.get('title'),body.get('description'),bool(approved)))
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if self.path=='/api/full-retry':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict) or not isinstance(body.get('id'),str):raise ValueError('Choose a failed full-video job.')
    return self.send(full_jobs.retry(body['id']))
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if self.path=='/api/full-generate':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    return self.send(full_jobs.enqueue(body.get('book')))
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if self.path in ('/api/generate','/api/retry'):

   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=2048:raise ValueError('Invalid request size')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict):raise ValueError('Invalid request')
    result=jobs.enqueue(body.get('book'),retry=self.path=='/api/retry')
    return self.send(result)
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if self.path=='/api/batch-decision':
   try:
    length=int(self.headers.get('Content-Length','0'))
    if not 0<length<=8192: raise ValueError('Batch request too large')
    body=json.loads(self.rfile.read(length))
    if not isinstance(body,dict) or not isinstance(body.get('ids'),list):raise ValueError()
    ids=body.get('ids',[]); status=body.get('status')
    if not ids or status not in ('approved','rejected'): raise ValueError()
    results={'success':[],'failed':[]}
    with connection() as c:
     for id in ids[:50]:
      try:
       item=next((x for x in inventory() if x['id']==id),None)
       if not item or (status=='approved' and not item['ready']): raise ValueError('Invalid item')
       if status=='approved':
        quality.validate_decision(item['quality'],body.get('checks',{}))
        c.execute('INSERT INTO editorial_reviews(id,fingerprint,checks) VALUES (?,?,?) ON CONFLICT(id) DO UPDATE SET fingerprint=excluded.fingerprint,checks=excluded.checks,updated=CURRENT_TIMESTAMP',(item['id'],item['quality']['fingerprint'],json.dumps(body.get('checks',{}))))
       c.execute('INSERT INTO decisions(id,status) VALUES (?,?) ON CONFLICT(id) DO UPDATE SET status=excluded.status,updated=CURRENT_TIMESTAMP',(item['id'],status))
       results['success'].append(id)
      except Exception as e: results['failed'].append({'id':id,'error':str(e)[:200]})
    return self.send(results)
   except (ValueError,TypeError) as e:return self.send({'error':str(e)},status=400)
  if self.path!='/api/decision': return self.send({'error':'Not found'},status=404)
  try:
   length=int(self.headers.get('Content-Length','0'))
   if not 0<length<=2048: raise ValueError()
   body=json.loads(self.rfile.read(length))
   if not isinstance(body,dict):raise ValueError()
   item=next((x for x in inventory() if x['id']==body.get('id')),None); status=body.get('status')
   if not item or status not in ('review','approved','rejected') or (status=='approved' and not item['ready']): raise ValueError()
  except (ValueError,TypeError): return self.send({'error':'Invalid decision'},status=400)
  if status=='approved':
   try:quality.validate_decision(item['quality'],body.get('checks'))
   except ValueError as e:return self.send({'error':str(e)},status=400)
  with connection() as c:
   if status=='approved':c.execute('INSERT INTO editorial_reviews(id,fingerprint,checks) VALUES (?,?,?) ON CONFLICT(id) DO UPDATE SET fingerprint=excluded.fingerprint,checks=excluded.checks,updated=CURRENT_TIMESTAMP',(item['id'],item['quality']['fingerprint'],json.dumps(body['checks'])))
   c.execute('INSERT INTO decisions(id,status) VALUES (?,?) ON CONFLICT(id) DO UPDATE SET status=excluded.status,updated=CURRENT_TIMESTAMP',(item['id'],status))
  self.send({'status':status})
if __name__=='__main__':
 os.umask(0o077)
 if DB.exists():DB.chmod(0o600)
 try:
  import brand_workspace
  brand_workspace.start_mindlore_publisher()
 except Exception:print('Optional MindLore publishing worker unavailable; ShelfMade continues.',flush=True)
 connection().close(); multiplatform.recover_interrupted(); youtube_api.recover_interrupted(); server=ThreadingHTTPServer(('127.0.0.1',8765),Handler); jobs.DAILY_CALLBACK=lambda:daily_plan.queue_fresh(inventory(),publishing.list_posts()+multiplatform.rows()); jobs.start(); full_jobs.start()
 try:brand_workspace.start_mindlore_daily()
 except Exception:print('Optional MindLore daily draft worker unavailable; ShelfMade continues.',flush=True)
 youtube_api.start_monitor(); audience_learning.start(inventory); print('ShelfMade dashboard: http://127.0.0.1:8765',flush=True); server.serve_forever()
