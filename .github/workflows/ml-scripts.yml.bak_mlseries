name: ml-scripts
on:
  schedule:
    - cron: '30 7,13,19,1 * * *'
  workflow_dispatch:
    inputs:
      count:
        description: 'How many new MindLore scripts to write'
        default: '3'
permissions:
  contents: write
jobs:
  write:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Write and check new scripts
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          CEREBRAS_API_KEY: ${{ secrets.CEREBRAS_API_KEY }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          ML_PER_PASS: ${{ github.event.inputs.count || '2' }}
        run: |
          [ -n "$GEMINI_API_KEY" ] || { echo "GEMINI_API_KEY secret missing"; exit 1; }
          python ml_autoscripts.py
      - name: Save new scripts
        run: |
          git config user.name "mindlore-bot"; git config user.email "bot@users.noreply.github.com"
          git add -f cinematic-scripts-mindlore
          git diff --cached --quiet && { echo "nothing new"; exit 0; }
          git commit -qm "MindLore: new scripts written and checked automatically"
          for i in 1 2 3 4 5; do git pull --rebase -q && git push -q && break; sleep $((RANDOM % 10 + 5)); done
