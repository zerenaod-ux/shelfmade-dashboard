"""Five auditable local opening choices. Heuristic screening, not AI fact checking or prediction.
Never reads credentials, fetches footage, renders, approves or publishes.
"""
import copy,re
import creative_quality as cq
import opening_design
import footage_director
VERSION='creative-director-v1'
PROMISE=re.compile(r'\b(guaranteed|miracle|cure|instantly rich|everyone must|secret they hide)\b',re.I)
VAGUE=re.compile(r'\b(did you know|this changes everything|you won.t believe|one weird trick)\b',re.I)

def title_for(hook,headline):
 return hook if len(hook)<=100 else headline.capitalize()

def brief_for(text,title):
 try:return footage_director.brief(text,title)
 except ValueError:return None

def finish(script,trials,full):
 """Choose from exactly five distinct candidates, preserving deterministic ties."""
 distinct=[];seen=set()
 for trial in trials:
  key=cq.norm(trial['hook'])
  if key in seen:continue
  seen.add(key);distinct.append(trial)
  if len(distinct)==5:break
 if len(distinct)<5:raise ValueError('Creative director needs five distinct supported opening choices. Add source/editorial material; no filler openings were invented.')
 candidates=[]
 for index,trial in enumerate(distinct):
  report=cq.script_review(trial,trial['source_evidence'],full);errors=list(report['errors']);hook=trial['hook'];cover=trial['thumbnail_headline'];scene=brief_for(trial['sections'][0]['narration'] if full else hook,trial['title'])
  if PROMISE.search(hook+' '+cover+' '+trial.get('public_title','')):errors.append('Unsupported promise or sensational claim needs editorial review.')
  if VAGUE.search(hook):errors.append('Opening is vague clickbait rather than a specific lesson.')
  if scene is None:errors.append('Opening has no supported filmable theme; add a concrete editorial opening.')
  words=hook.split();evidence=' '.join(p['excerpt'] for p in trial['source_evidence'])
  components={'clarity':max(0,10-abs(len(words)-12)//2),'source_overlap':min(10,len(cq.tokens(hook)&cq.tokens(evidence))),'curiosity':3*int('?' in hook)+2*int(bool(re.search(r'\b(if|but|why|how|when|never)\b',hook,re.I))),'visual_specificity':min(8,len(scene.get('keywords',[]))*2) if scene else 0,'cover_connection':5*int(cq.related(cover,hook))}
  candidates.append({'id':index+1,'hook':hook,'headline':cover,'public_title':trial['public_title'],'basis':trial.get('_director_basis','existing supported opening'),'scores':components,'score':sum(components.values()),'eligible':not errors,'rejections':list(dict.fromkeys(errors)),'scene_brief':scene,'scene_basis':'Opening paragraph including hook' if full else 'Spoken hook','source_checkpoints':trial['source_evidence']})
 eligible=[c for c in candidates if c['eligible']]
 if not eligible:raise ValueError('Creative director: all five openings need editorial attention. '+ ' '.join(dict.fromkeys(e for c in candidates for e in c['rejections'])))
 chosen=max(eligible,key=lambda c:(c['score'],-c['id']));result=copy.deepcopy(distinct[chosen['id']-1]);result.pop('_director_basis',None)
 chapters=result['sections'] if full else [{'title':'Opening','narration':result['hook']},*[{'title':'Lesson '+str(i+1),'narration':p} for i,p in enumerate(result['points'])]]
 plan=[]
 for index,chapter in enumerate(chapters):
  brief=brief_for(chapter['narration'],chapter['title'])
  plan.append({'chapter':index,'title':chapter['title'],'narration_anchor':chapter['narration'][:240],'theme':brief['theme'] if brief else None,'subject':brief.get('subject') if brief else None,'queries':brief['queries'] if brief else [],'review_required':True,'purpose':'Show a concrete interpretation of this idea; metadata is not visual verification.'})
 result['creative_director']={'version':VERSION,'selected_id':chosen['id'],'candidates':candidates,'selection_reason':'Highest eligible local rubric score; ties keep the earlier candidate. Scores are heuristics, not measured audience predictions.','scene_plan':plan,'review_required':True,'limits':'Source overlap cannot certify truth or interpretation. Review original context, complete narration, cover and actual footage. No learned performance model is used.'}
 return result

def short(script,ranked):
 trials=[copy.deepcopy(script)];trials[0]['_director_basis']='Existing source-backed opening'
 for sentence in ranked:
  if sentence in script['points'] or cq.norm(sentence)==cq.norm(script['hook']):continue
  trial=copy.deepcopy(script);trial['hook']=sentence;trial['thumbnail_headline']=opening_design.short_headline(sentence);trial['public_title']=title_for(sentence,trial['thumbnail_headline'])
  trial['source_evidence']=copy.deepcopy(script['source_evidence'])+[{'chapter':'Candidate opening','kind':'source passage','excerpt':sentence,'source_url':script['source_evidence'][0]['source_url'],'verification':'Exact cleaned source sentence; verify context and interpretation during review.'}]
  trial['_director_basis']='Exact cleaned source sentence; not an invented author quotation';trials.append(trial)
 return finish(script,trials,False)

def full(script):
 trials=[copy.deepcopy(script)];trials[0]['_director_basis']='Existing source-linked editorial opening'
 for section_index,section in enumerate(script['sections'][1:-1],1):
  for sentence in re.split(r'(?<=[.!?])\s+',section['narration']):
   if re.match(r'(?i)(now bring|start with|in summary|to sum up|carry these|before the next video|this lesson)',sentence):continue
   if not 5<=len(sentence.split())<=30 or any(word in sentence.lower() for word in ('our modern','not a quotation','subscribe','this exercise','our application')):continue
   trial=copy.deepcopy(script);old=trial['hook'];trial['hook']=sentence;trial['sections'][0]['narration']=sentence+trial['sections'][0]['narration'][len(old):]
   trial['thumbnail_headline']=opening_design.short_headline(sentence);trial['public_title']=title_for(sentence,trial['thumbnail_headline']);trial['opening_payoff']={'section':section_index,'chapter':section['title'],'question':sentence,'review':'Does the lesson examine this opening claim in source context?'}
   trial['_director_basis']='Existing editorial narration from '+section['title']+'; not an author quotation'
   trial['source_evidence']=copy.deepcopy(script['source_evidence'])+[{'section':section_index,'chapter':section['title'],'kind':'editorial narration checkpoint','excerpt':section['narration'][:1000],'source_url':script['source_url'],'verification':'Existing commentary, not independently verified source wording. Compare with original book.'}];trials.append(trial)
 # Prefer different lesson openings before later sentences from the same chapter.
 first=trials[:1];by_chapter={}
 for trial in trials[1:]:by_chapter.setdefault(trial['opening_payoff']['section'],[]).append(trial)
 while any(by_chapter.values()):
  for group in by_chapter.values():
   if group:first.append(group.pop(0))
 return finish(script,first,True)
